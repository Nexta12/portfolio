# -----------------------------------------------------------------------------
# Portfolio Environment Configuration (.env.example)
# Copy this file to .env.local to customize your personal data & API endpoints.
# NEVER commit your actual .env.local to version control.
# -----------------------------------------------------------------------------

# Personal & Founder Details
NEXT_PUBLIC_PERSONAL_NAME="Udeze Ernest"
NEXT_PUBLIC_PERSONAL_SHORT_NAME="Ernest"
NEXT_PUBLIC_PERSONAL_EMAIL="your-email@example.com"
NEXT_PUBLIC_GITHUB_URL="https://github.com/your-username"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/in/your-profile"
NEXT_PUBLIC_TWITTER_URL="https://x.com/your-handle"
NEXT_PUBLIC_RESUME_URL="#resume"
NEXT_PUBLIC_CAL_URL="https://cal.com/your-handle"

# Product & Control Plane Endpoints
NEXT_PUBLIC_SPIDER_API_URL="https://api.spiderweb.com.ng"
NEXT_PUBLIC_SPIDER_GITHUB_URL="https://github.com/your-org/spider"

# Deployment / Site URL
NEXT_PUBLIC_SITE_URL="https://udezeernest.dev"
